.cache/
.local/
.agents/
.replit
.replitignore
.upm/
.config/

# Migration artefacts (pre-workspace backup — not part of the source)
.migration-backup/

# Uploaded prompt/asset files from the build process (not source code)
attached_assets/

# Generated pitch deck images (large binary, reproducible via media-generation)
artifacts/delbar-pitch-deck/public/hero-wine.png
